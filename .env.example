VITE_OPEN_PLAY_SHARED=false
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_BROWSER_SAFE_PUBLISHABLE_OR_ANON_KEY

# Production uses VITE_OPEN_PLAY_SHARED=true. Only VITE_ values are bundled into
# the browser, so never put service-role keys, PINs, session tokens, device
# tokens, or enrollment codes in this file or in Vercel environment variables.
# Device credentials are provisioned per terminal through the in-app OWNER flow.
